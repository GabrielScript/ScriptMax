# Copie para .env e preencha. Nunca versione o .env.

# Obrigatórias
GROQ_API_KEY=            # https://console.groq.com/keys (plano grátis: 8 h de áudio/dia)
DEEPSEEK_API_KEY=        # https://platform.deepseek.com/api_keys

# Modelos (padrões recomendados)
TRANSCRIPTION_MODEL=whisper-large-v3        # ou whisper-large-v3-turbo (64% mais barato, um pouco menos preciso)
SUMMARY_MODEL=deepseek-flash

# Servidor
HOST=127.0.0.1           # mantenha local; para o celular use ngrok + APP_TOKEN
PORT=8000
APP_TOKEN=               # obrigatório se expor via ngrok/LAN (mín. 16 caracteres)
MAX_UPLOAD_MB=500
# LIBRARY_DIR=C:\Users\voce\Documents\ScriptMax   # onde ficam as pastas de PDFs (padrão: data/biblioteca)
# FFMPEG_PATH=C:\caminho\ffmpeg.exe              # só se o ffmpeg não estiver no PATH

# E-mail (opcional; Gmail exige "senha de app")
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
